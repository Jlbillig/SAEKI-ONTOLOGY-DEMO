@prefix ft: <https://example.org/factory-trace#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ft:FactoryTraceOntology a owl:Ontology ;
  rdfs:label "FactoryTrace Ontology" ;
  rdfs:comment "A scoped ontology for CNC quality deviation traceability." .

ft:PhysicalEntity a owl:Class ; rdfs:label "Physical Entity" .
ft:Machine a owl:Class ; rdfs:subClassOf ft:PhysicalEntity ; rdfs:label "Machine" .
ft:CNCMachine a owl:Class ; rdfs:subClassOf ft:Machine ; rdfs:label "CNC Machine" .
ft:InspectionStation a owl:Class ; rdfs:subClassOf ft:Machine ; rdfs:label "Inspection Station" .
ft:WorkCell a owl:Class ; rdfs:subClassOf ft:PhysicalEntity ; rdfs:label "Work Cell" .
ft:Tool a owl:Class ; rdfs:subClassOf ft:PhysicalEntity ; rdfs:label "Tool" .
ft:CuttingTool a owl:Class ; rdfs:subClassOf ft:Tool ; rdfs:label "Cutting Tool" .
ft:Sensor a owl:Class ; rdfs:subClassOf ft:PhysicalEntity ; rdfs:label "Sensor" .
ft:Part a owl:Class ; rdfs:subClassOf ft:PhysicalEntity ; rdfs:label "Part" .
ft:MaterialBatch a owl:Class ; rdfs:subClassOf ft:PhysicalEntity ; rdfs:label "Material Batch" .
ft:Operator a owl:Class ; rdfs:subClassOf ft:PhysicalEntity ; rdfs:label "Operator" .
ft:Process a owl:Class ; rdfs:label "Process" .
ft:ManufacturingOperation a owl:Class ; rdfs:subClassOf ft:Process ; rdfs:label "Manufacturing Operation" .
ft:MillingOperation a owl:Class ; rdfs:subClassOf ft:ManufacturingOperation ; rdfs:label "Milling Operation" .
ft:DrillingOperation a owl:Class ; rdfs:subClassOf ft:ManufacturingOperation ; rdfs:label "Drilling Operation" .
ft:InspectionOperation a owl:Class ; rdfs:subClassOf ft:ManufacturingOperation ; rdfs:label "Inspection Operation" .
ft:MaintenanceOperation a owl:Class ; rdfs:subClassOf ft:ManufacturingOperation ; rdfs:label "Maintenance Operation" .
ft:Event a owl:Class ; rdfs:label "Event" .
ft:ProductionStartEvent a owl:Class ; rdfs:subClassOf ft:Event ; rdfs:label "Production Start Event" .
ft:TelemetryEvent a owl:Class ; rdfs:subClassOf ft:Event ; rdfs:label "Telemetry Event" .
ft:OperationCompleteEvent a owl:Class ; rdfs:subClassOf ft:Event ; rdfs:label "Operation Complete Event" .
ft:QualityEvent a owl:Class ; rdfs:subClassOf ft:Event ; rdfs:label "Quality Event" .
ft:QualityDeviation a owl:Class ; rdfs:subClassOf ft:QualityEvent ; rdfs:label "Quality Deviation" .
ft:AlarmEvent a owl:Class ; rdfs:subClassOf ft:Event ; rdfs:label "Alarm Event" .
ft:State a owl:Class ; rdfs:label "State" .
ft:MachineState a owl:Class ; rdfs:subClassOf ft:State ; rdfs:label "Machine State" .
ft:OperationalState a owl:Class ; rdfs:subClassOf ft:State ; rdfs:label "Operational State" .
ft:AnomalyState a owl:Class ; rdfs:subClassOf ft:State ; rdfs:label "Anomaly State" .
ft:InformationEntity a owl:Class ; rdfs:label "Information Entity" .
ft:WorkOrder a owl:Class ; rdfs:subClassOf ft:InformationEntity ; rdfs:label "Work Order" .
ft:Specification a owl:Class ; rdfs:subClassOf ft:InformationEntity ; rdfs:label "Specification" .
ft:ToleranceRequirement a owl:Class ; rdfs:subClassOf ft:InformationEntity ; rdfs:label "Tolerance Requirement" .
ft:InspectionResult a owl:Class ; rdfs:subClassOf ft:InformationEntity ; rdfs:label "Inspection Result" .
ft:RootCauseHypothesis a owl:Class ; rdfs:subClassOf ft:InformationEntity ; rdfs:label "Root Cause Hypothesis" .
ft:TemporalEntity a owl:Class ; rdfs:label "Temporal Entity" .
ft:Shift a owl:Class ; rdfs:subClassOf ft:TemporalEntity ; rdfs:label "Shift" .
ft:ProductionRun a owl:Class ; rdfs:subClassOf ft:TemporalEntity ; rdfs:label "Production Run" .

ft:performedByMachine a owl:ObjectProperty ; rdfs:domain ft:ManufacturingOperation ; rdfs:range ft:Machine ; rdfs:label "performed by machine" .
ft:actsOnPart a owl:ObjectProperty ; rdfs:domain ft:ManufacturingOperation ; rdfs:range ft:Part ; rdfs:label "acts on part" .
ft:usesTool a owl:ObjectProperty ; rdfs:domain ft:ManufacturingOperation ; rdfs:range ft:Tool ; rdfs:label "uses tool" .
ft:processedMaterialBatch a owl:ObjectProperty ; rdfs:domain ft:Part ; rdfs:range ft:MaterialBatch ; rdfs:label "processed material batch" .
ft:hasTelemetryEvent a owl:ObjectProperty ; rdfs:domain ft:Machine ; rdfs:range ft:TelemetryEvent ; rdfs:label "has telemetry event" .
ft:hasInspectionResult a owl:ObjectProperty ; rdfs:domain ft:Part ; rdfs:range ft:InspectionResult ; rdfs:label "has inspection result" .
ft:partOfProductionRun a owl:ObjectProperty ; rdfs:domain ft:ManufacturingOperation ; rdfs:range ft:ProductionRun ; rdfs:label "part of production run" .
ft:associatedWithMachine a owl:ObjectProperty ; rdfs:domain ft:Event ; rdfs:range ft:Machine ; rdfs:label "associated with machine" .
ft:associatedWithPart a owl:ObjectProperty ; rdfs:domain ft:Event ; rdfs:range ft:Part ; rdfs:label "associated with part" .
ft:associatedWithTool a owl:ObjectProperty ; rdfs:domain ft:Event ; rdfs:range ft:Tool ; rdfs:label "associated with tool" .
ft:hasWorkOrder a owl:ObjectProperty ; rdfs:domain ft:ManufacturingOperation ; rdfs:range ft:WorkOrder ; rdfs:label "has work order" .

ft:eventId a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "event id" .
ft:machineId a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "machine id" .
ft:partId a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "part id" .
ft:toolId a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "tool id" .
ft:batchId a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "batch id" .
ft:workOrderId a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "work order id" .
ft:timestampValue a owl:DatatypeProperty ; rdfs:range xsd:dateTime ; rdfs:label "timestamp value" .
ft:spindleSpeedRPM a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "spindle speed RPM" .
ft:feedRateMMMin a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "feed rate mm per minute" .
ft:vibrationMMs a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "vibration mm per second" .
ft:temperatureC a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "temperature Celsius" .
ft:cycleTimeSec a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "cycle time seconds" .
ft:axisLoadXPct a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "axis load x percent" .
ft:axisLoadYPct a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "axis load y percent" .
ft:axisLoadZPct a owl:DatatypeProperty ; rdfs:range xsd:decimal ; rdfs:label "axis load z percent" .
ft:eventStatus a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "event status" .
ft:deviationType a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "deviation type" .
ft:inspectionStatus a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "inspection status" .
